# Copy this file to .env and fill in the keys you plan to use.
# repo2readme also works without a .env file: on first run, the CLI
# will interactively prompt for missing keys and store them in
# ~/.repo2readme_env.json for future runs.
#
# You only need the key for the provider selected with --provider.
# Groq is the default provider for summarization and README generation/review.

# Groq — default provider (model: openai/gpt-oss-120b)
# Get a key at: https://console.groq.com
GROQ_API_KEY=

# Google Gemini — optional provider (model: gemini-2.5-flash)
# Get a key at: https://aistudio.google.com
GOOGLE_API_KEY=

# Optional: other supported providers via --provider
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
TOGETHER_API_KEY=
